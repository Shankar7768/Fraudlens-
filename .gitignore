# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
env/
venv/
ENV/

# Data & Datasets (Non-CSV files / SQLite / JSON Lines / Parquet)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/features/*
!data/features/.gitkeep
*.npy
*.db
*.sqlite
*.sqlite3
data/*.db

# Model weights & large binary artifacts
models/*
!models/.gitkeep
*.pt
*.bin
*.joblib
*.pkl
*.onnx

# Environment & Secret Keys
.env
.env.local

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# Node / Frontend build artifacts (when frontend is built)
frontend/node_modules/
frontend/dist/
frontend/build/
