# Gemini API Key for LLM-Assisted Feature Extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Extractor Model Settings
LLM_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048
LLM_RATE_LIMIT_DELAY=0.5

# Data Paths
RAW_DATA_PATH=data/raw/dataset.jsonl
PROCESSED_DATA_PATH=data/processed/dataset_with_features.jsonl

# Ingestion Settings
HF_DATASET_NAME=victor/real-or-fake-fake-jobposting-prediction
DEFAULT_BATCH_SIZE=10
